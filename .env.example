PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
RATE_LIMIT_MAX=120

# Explicit runtime posture: public-demo or required.
CRIX_AUTH_MODE=public-demo
# Required mode only. Comma-separated current,next rotation set; max 2 active keys.
# Legacy CRIX_API_KEY is accepted only as a single-key alias when CRIX_AUTH_MODE is explicit.
CRIX_API_KEYS=
# Number of explicitly trusted reverse-proxy hops. Default 0; do not set blindly.
CRIX_TRUST_PROXY_HOPS=0

# Optional OpenTelemetry metrics. Disabled by default.
CRIX_TELEMETRY_ENABLED=false
# Required when telemetry is enabled. Example: https://otel-collector.example.com/v1/metrics
CRIX_OTEL_METRICS_ENDPOINT=
CRIX_OTEL_EXPORT_INTERVAL_MS=30000

# Optional comma-separated browser origins. CORS is disabled when empty.
CORS_ORIGIN=
